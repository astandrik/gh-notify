# Telegram bot token from @BotFather
TG_BOT_TOKEN=

# GitHub Personal Access Token
# Required permissions: notifications (read), pull_requests (read), issues (read)
GH_TOKEN=

# Telegram chat ID (optional — auto-detected on /start)
CHAT_ID=

# Polling interval in milliseconds (default: 60000 = 60s)
POLL_INTERVAL=60000
